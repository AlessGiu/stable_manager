<odoo>
    <data>

        <!-- === LIST VIEW: Displays key fields of all horses === -->
        <record id="horse_list_view" model="ir.ui.view">
            <field name="name">stable_horse_list</field>
            <field name="model">stable.horse</field>
            <field name="arch" type="xml">
                <list string="All Horses">
                    <field name="name" string="Name"/>
                    <field name="owner_id" string="Owner"/>
                    <field name="sireno" string="SIRE No"/>
                    <field name="birth_date" string="Birth Date"/>
                    <field name="sexe" string="Sex"/>
                    <field name="robe" string="Coat"/>
                    <field name="taille" string="Height (cm)"/>
                </list>
            </field>
        </record>

        <!-- === SEARCH VIEW: Enables filtering horses by attributes === -->
        <record id="horse_search_view" model="ir.ui.view">
            <field name="name">stable.horse.search</field>
            <field name="model">stable.horse</field>
            <field name="arch" type="xml">
                <search string="Search Horses">
                    <field name="name"/>
                    <field name="owner_id"/>
                    <field name="race"/>
                    <field name="type_pension"/>
                    <field name="in_competition"/>
                    <filter name="competition_filter" string="In competition" domain="[('in_competition','=',True)]"/>
                    <filter name="no_chip" string="No chip" domain="[('puce_elec','=',False)]"/>
                </search>
            </field>
        </record>

        <!-- === ACTION: Open form to create a ration line === -->
        <record id="action_add_ration_line" model="ir.actions.act_window">
            <field name="name">Add a ration line</field>
            <field name="res_model">stable.ration.line</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- === ACTION: Open competition records for this horse (current year) === -->
        <record id="action_stable_competition_this_year" model="ir.actions.act_window">
            <field name="name">Competitions this year</field>
            <field name="res_model">stable.competition</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('horse_id', '=', active_id)]</field>
        </record>

        <!-- === ACTION: Open vaccination records for this horse (current year) === -->
        <record id="action_stable_vaccin_this_year" model="ir.actions.act_window">
            <field name="name">Vaccinations</field>
            <field name="res_model">stable.vaccins</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('horse_id', '=', active_id)]</field>
        </record>

        <!-- === FORM VIEW: Detailed horse profile with organized tabs === -->
        <record id="view_horse_form" model="ir.ui.view">
            <field name="name">stable_horse_form</field>
            <field name="model">stable.horse</field>
            <field name="arch" type="xml">
                <form>

                    <header>
                        <!-- Stat button: competitions this year -->
                        <button name="%(action_stable_competition_this_year)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-trophy">
                            <field name="competition_this_year" widget="statinfo"/>
                        </button>

                        <!-- Stat button: vaccinations this year -->
                        <button name="%(action_stable_vaccin_this_year)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-medkit">
                            <field name="vaccins_ids" widget="statinfo"/>
                        </button>

                        <!-- Print button -->
                        <button name="%(action_report_horse)d"
                                type="action"
                                string="Print Profile"
                                class="oe_highlight"
                                icon="fa-print"/>
                    </header>

                    <sheet>

                        <!-- Ribbon: indicates competition status -->
                        <widget name="web_ribbon"
                                title="In Competition"
                                bg_color="bg-primary"
                                invisible="not in_competition"/>

                        <!-- Title block -->
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Horse's name"/>
                            </h1>
                        </div>

                        <!-- Identity / physical / boarding info -->
                        <group col="3">
                            <group string="Identity">
                                <field name="sireno" placeholder="Official SIRE number"/>
                                <field name="birth_date"/>
                                <field name="age"/>
                                <field name="sexe"/>
                                <field name="race"/>
                                <field name="image_1920" widget="image"
                                       class="oe_avatar"
                                       options="{'preview_image': 'image_1920'}"/>
                            </group>

                            <group string="Physical Characteristics">
                                <field name="robe"/>
                                <field name="taille"/>
                                <field name="poids"/>
                                <field name="puce_elec"/>
                            </group>

                            <group string="Status and Boarding">
                                <field name="type_pension"/>
                                <field name="owner_id"/>
                                <field name="in_competition"/>
                            </group>
                        </group>

                        <!-- Tabs: show related records -->
                        <notebook>

                            <!-- === TAB: Rations === -->
                            <page string="Rations">
                                <group>
                                    <field name="ration_id" invisible="1"/>
                                    <div class="d-flex align-items-center justify-content-between mb-2"
                                         style="width: 100%;">
                                        <div>
                                            <button name="action_add_ration_line"
                                                    type="object"
                                                    string="Add item"
                                                    class="btn btn-primary"/>
                                        </div>
                                    </div>
                                    <field name="ration_line_ids" mode="kanban"/>
                                </group>
                            </page>

                            <!-- === TAB: Competitions === -->
                            <page string="Competitions">
                                <field name="competition_ids"/>
                            </page>

                            <!-- === TAB: Vaccines === -->
                            <page string="Vaccines">
                                <field name="vaccins_ids"/>
                            </page>

                            <!-- === TAB: Osteopath === -->
                            <page string="Osteopath">
                                <field name="osteopath_ids"/>
                            </page>

                            <!-- === TAB: Dentist === -->
                            <page string="Dentist">
                                <field name="dentist_ids"/>
                            </page>

                            <!-- === TAB: Farrier === -->
                            <page string="Farrier">
                                <field name="farrier_ids"/>
                            </page>

                            <!-- === TAB: Veterinarian === -->
                            <page string="Veterinarian">
                                <field name="veterinary_ids"/>
                            </page>

                        </notebook>

                    </sheet>

                    <!-- Chatter widget -->
                    <chatter/>

                </form>
            </field>
        </record>

        <!-- === KANBAN VIEW: Visual horse cards === -->
        <record id="view_kanban_stable_horse" model="ir.ui.view">
            <field name="name">stable_horse_kanban</field>
            <field name="model">stable.horse</field>
            <field name="arch" type="xml">
                <kanban>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="o_kanban_box">
                                <div class="o_kanban_image">
                                    <img t-att-src="kanban_image('stable.horse', 'image_1920', record.id.value)"
                                         class="oe_kanban_avatar"
                                         alt="Horse Image"/>
                                </div>
                                <div class="o_kanban_details">
                                    <field name="name"/>
                                    <div>
                                        <field name="robe"/>
                                        •
                                        <field name="sexe"/>
                                    </div>
                                    <div>Owner:
                                        <field name="owner_id"/>
                                    </div>
                                    <div>Pension type:
                                        <field name="type_pension"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- === KANBAN VIEW: Ration line cards === -->
        <record id="view_stable_ration_line_kanban" model="ir.ui.view">
            <field name="name">stable.ration.line.kanban</field>
            <field name="model">stable.ration.line</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_global_click">
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card"
                                 style="border: 1px solid #ddd; padding: 10px; border-radius: 8px; background-color: #fdfdfd; box-shadow: 1px 1px 4px rgba(0,0,0,0.05);">
                                <div class="oe_kanban_details" style="margin-bottom: 8px;">
                                    <strong style="font-size: 16px; color: #2c3e50;">
                                        <field name="product_id"/>
                                    </strong>
                                </div>
                                <div style="margin-bottom: 5px;">
                                    <span style="font-weight: bold; color: #7f8c8d;">Quantity:</span>
                                    <field name="quantity" class="oe_inline"/>
                                    <field name="uom_id" class="oe_inline"/>
                                </div>
                                <div style="margin-bottom: 5px;">
                                    <span style="font-weight: bold; color: #7f8c8d;">Note:</span>
                                    <field name="note" class="oe_inline"/>
                                </div>
                                <div style="margin-bottom: 10px;">
                                    <span style="font-size: 12px; color: #95a5a6;">Linked ration:</span>
                                    <field name="ration_id"/>
                                </div>
                                <div style="display: flex; justify-content: space-between; margin-top: 10px;">
                                    <a type="object" name="unlink" class="btn btn-danger btn-sm">Delete</a>
                                    <a type="object" name="open_ration_line_form" class="btn btn-primary btn-sm">Edit
                                    </a>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- === ACTION: Open horse management views === -->
        <record id="open_view_horses" model="ir.actions.act_window">
            <field name="name">Horses</field>
            <field name="res_model">stable.horse</field>
            <field name="view_mode">kanban,list,form</field>
        </record>

        <!-- === MAIN MENU: Root menu for stable management === -->
        <menuitem id="menu_stable"
                  name="Stable Management"
                  groups="stable_manager.group_stagiaire"
                  web_icon="stable_manager,static/description/icon.png"
                  sequence="10"/>

        <!-- === MENU: Horse management === -->
        <menuitem id="stable_manager_menu_view"
                  name="Horses"
                  parent="menu_stable"
                  action="open_view_horses"
                  groups="stable_manager.group_stagiaire"/>

        <!-- === MENU: Health-related sections === -->
        <menuitem id="menu_health"
                  name="Health"
                  parent="menu_stable"
                  sequence="20"/>

    </data>
</odoo>
