<odoo>
    <!-- Vue liste stable.ration.line -->
    <record id="view_stable_ration_line_list" model="ir.ui.view">
        <field name="name">stable.ration.line.list</field>
        <field name="model">stable.ration.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="ration_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="uom_id"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire stable.ration.line -->
    <record id="view_stable_ration_line_form" model="ir.ui.view">
        <field name="name">stable.ration.line.form</field>
        <field name="model">stable.ration.line</field>
        <field name="arch" type="xml">
            <form string="Ligne de ration">
                <sheet>
                    <group>
                        <field name="ration_id"/>
                        <field name="product_id"/>
                        <field name="quantity"/>
                        <field name="uom_id"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action pour voir les lignes de ration -->
    <record id="action_stable_ration_line" model="ir.actions.act_window">
        <field name="name">Lignes de ration</field>
        <field name="res_model">stable.ration.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu (optionnel)
    <menuitem id="menu_stable_ration_line"
              name="Lignes de ration"
              parent="menu_stable"
              action="action_stable_ration_line"
              sequence="40"/> -->
</odoo>
