<odoo>
    <data noupdate="1">

        <!-- Cron pour les recherches automatiques de compétitions -->
        <record id="cron_competition_auto_search" model="ir.cron">
            <field name="name">Recherches automatiques de compétitions FFE</field>
            <field name="model_id" ref="model_stable_competition_search"/>
            <field name="type">ir.actions.server</field>
            <field name="state">code</field>
            <field name="code">model.run_auto_searches()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>